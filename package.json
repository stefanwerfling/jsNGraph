{
  "name": "jsngraph",
  "version": "0.2.0",
  "description": "Interactive network topology graph rendering — TypeScript, Canvas, force-directed layout, zero runtime dependencies.",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/jsngraph.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./graph": {
      "types": "./dist/graph.d.ts",
      "import": "./dist/graph.js",
      "require": "./dist/graph.cjs"
    },
    "./rect": {
      "types": "./dist/rect.d.ts",
      "import": "./dist/rect.js",
      "require": "./dist/rect.cjs"
    },
    "./modelview": {
      "types": "./dist/modelview.d.ts",
      "import": "./dist/modelview.js",
      "require": "./dist/modelview.cjs"
    },
    "./workflow": {
      "types": "./dist/workflow.d.ts",
      "import": "./dist/workflow.js",
      "require": "./dist/workflow.cjs"
    },
    "./widget": {
      "types": "./dist/widget.d.ts",
      "import": "./dist/widget.js",
      "require": "./dist/widget.cjs"
    },
    "./netview": {
      "types": "./dist/netview.d.ts",
      "import": "./dist/netview.js",
      "require": "./dist/netview.cjs"
    },
    "./chart": {
      "types": "./dist/chart.d.ts",
      "import": "./dist/chart.js",
      "require": "./dist/chart.cjs"
    },
    "./records": {
      "types": "./dist/records.d.ts",
      "import": "./dist/records.js",
      "require": "./dist/records.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stefanwerfling/jsNGraph.git"
  },
  "scripts": {
    "prepare": "tsup",
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "tsup": "^8.3.5",
    "vitest": "^2.1.8"
  }
}
